              "path": ["orders", "{{orderId}}", "invoice"]
            },
            "description": "Generates structured compliant tax invoice with GST breakdowns, seller credentials, item lines, and OTP."
          }
        },
        {
          "name": "Merchant: Mark Order Ready to Ship (PACKED)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PACKED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            },
            "description": "Direct transition from PENDING to PACKED. Emits order.confirmed event initializing delivery dispatch."
          }
        },
        {
          "name": "Rider: Verify Delivery 4-Digit OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "verify-otp"]
            }
          }
        },
        {
          "name": "Customer: Cancel Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
