    {
      "name": "04. Orders (Single-Store Core Pipeline)",
      "item": [
        {
          "name": "Create Order (Single-Store Cart Enforcement)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && (json.data.id || json.data._id)) {",
                  "        pm.collectionVariables.set('orderId', json.data.id || json.data._id);",
                  "        console.log('✅ orderId set to:', json.data.id || json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-idempotency-key", "value": "idem-key-{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"name\": \"Slim Fit Linen Shirt\",\n      \"quantity\": 1,\n      \"unitPrice\": 1299,\n      \"sku\": \"MENS-LINEN-001\"\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Arjun Mehta\",\n    \"phone\": \"9876543299\",\n    \"street\": \"Plot 14, Nehru Nagar West\",\n    \"city\": \"Bhilai\",\n    \"state\": \"Chhattisgarh\",\n    \"postalCode\": \"490020\",\n    \"coordinates\": [81.3410, 21.2180]\n  },\n  \"paymentMethod\": \"upi\",\n  \"fulfillmentType\": \"delivery\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
