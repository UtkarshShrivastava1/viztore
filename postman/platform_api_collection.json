    {
      "name": "05. Delivery & Rider Dispatch",
      "item": [
        {
          "name": "Track Order Delivery Status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/delivery/orders/{{orderId}}/track",
              "host": ["{{baseUrl}}"],
              "path": ["delivery", "orders", "{{orderId}}", "track"]
            }
          }
        },
        {
          "name": "Merchant: Assign Rider Partner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderName\": \"Ramesh Yadav\",\n  \"riderPhone\": \"9876543000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/orders/{{orderId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["delivery", "orders", "{{orderId}}", "assign"]
            }
          }
        },
        {
          "name": "Rider: Complete Handshake with Customer OTP",
