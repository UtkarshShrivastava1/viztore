{
  "name": "platform-root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=@repo/backend",
    "dev:merchant": "turbo run dev --filter=@repo/merchant",
    "dev:web": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "seed:merchants": "pnpm --filter=@repo/backend seed",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
