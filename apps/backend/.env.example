# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Note: Never commit real credentials or production secrets to source control.
# Copy this file to .env and configure environment-specific values.

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# In production, use MongoDB Atlas replica set URI with write concern majority.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/platform-db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/platform-db
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5

# ------------------------------------------------------------------------------
# Cache & Distributed Pub/Sub (Redis / Upstash / Redis Cloud)
# ------------------------------------------------------------------------------
# Set ENABLE_REDIS=false to run in in-memory mode without external Redis dependency.
ENABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
# Generate cryptographically secure 256-bit keys (min 32 characters) in production.
# Example: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# CORS & Allowed Client Origins
# ------------------------------------------------------------------------------
CLIENT_WEB_URL=http://localhost:3000
CLIENT_MERCHANT_URL=http://localhost:3001
# Comma-separated list of additional trusted origins (e.g., Vercel previews)
ADDITIONAL_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:3001

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Optional for local dev, Required for production CDN)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Graph API v20.0)
# ------------------------------------------------------------------------------
# When omitted or in test environments, WhatsAppService operates in dry-run mode.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# White-Label Branding (Backend Fallback Tokens)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=LocalStore
NEXT_PUBLIC_APP_TAGLINE=Shop Local. Shop Smart.
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_LOGO_URL=/logo.svg
NEXT_PUBLIC_THEME_COLOR=#6366f1
