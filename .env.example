# ==============================================================================
# VIZTORE PLATFORM — MASTER ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Invariant: Never commit actual passwords, private API keys, or JWT secrets.
# All environment variables must have non-sensitive placeholder values here.

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ------------------------------------------------------------------------------
# White-Label Branding (Canonical System)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=LocalStore
NEXT_PUBLIC_APP_TAGLINE=Shop Local. Shop Smart.
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_LOGO_URL=/logo.svg
NEXT_PUBLIC_THEME_COLOR=#6366f1

# ------------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/platform-db
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5

# ------------------------------------------------------------------------------
# Cache & Distributed Pub/Sub (Redis / Upstash / Redis Cloud)
# ------------------------------------------------------------------------------
ENABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# CORS & Allowed Client Origins
# ------------------------------------------------------------------------------
CLIENT_WEB_URL=http://localhost:3000
CLIENT_MERCHANT_URL=http://localhost:3001
ADDITIONAL_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:3001

# ------------------------------------------------------------------------------
# File Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Graph API v20.0)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# External Services & SMS (Phase 2+)
# ------------------------------------------------------------------------------
SMS_API_KEY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
